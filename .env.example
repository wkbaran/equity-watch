SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Optional: client-side throttle for the price-history endpoint.
# Schwab's documented limit is 120 calls/minute; lower this if you want
# headroom, or if you're hitting the API from something else in parallel.
SCHWAB_MAX_REQUESTS_PER_MINUTE=120

# Financial Modeling Prep API key, for the `profile` command (sector/industry/
# description cache - Schwab's API doesn't have this data). Free tier signup
# at https://site.financialmodelingprep.com/, no payment info required.
FMP_API_KEY=

# Browser dashboard publishing (`dashboard --publish`). Values come from the
# infra/cloudformation.yaml stack outputs.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- stack deployment (scripts/deploy-stack.sh / .ps1) ----------------------
#
# These are the CloudFormation parameters, kept here so a deploy never depends
# on remembering them. Every one of them defaults to empty or false in the
# template, so a deploy that omits one CLEARS it on the live stack: leaving
# EnableOps out deletes the Lambda and the queue, leaving CustomDomain out drops
# the domain and its certificate. deploy-stack refuses to blank anything the
# live stack has set, but only because it reads these.
#
# S3_BUCKET above is the bucket name. AWS_REGION is the deploy region.
STACK_NAME=equity-watch-dashboard

# Editing from the page. OPS_TOKEN below is the same secret the publisher uses
# to seal the holdings vault, so there is one value, not two.
ENABLE_OPS=false

# Custom domain (optional; empty serves from the *.cloudfront.net URL). The zone
# must be the PUBLIC Route 53 zone - a private zone of the same name is easy to
# pick by mistake, and neither certificate validation nor the alias record works
# in one.
CUSTOM_DOMAIN=
HOSTED_ZONE_ID=

# Basic auth over the whole site. Required before turning on web.holdings in
# analysis.config.json, which puts real share counts in dashboard.json.
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional dead-man's switch for scheduled runs (scripts/check-and-publish.ps1):
# pinged after each run, <url>/fail on failure. See docs/SCHEDULING.md.
HEALTHCHECK_URL=
